# OpenAI key for the in-product agents.
# Leave empty to run the agents in mock mode (deterministic, offline, clearly labeled in the UI).
OPENAI_API_KEY=

# Model used by all agents. Must support tool calling and structured outputs.
OPENAI_MODEL=gpt-4o-mini

# SQLite database file, relative to the project root. Created on first start.
DATABASE_PATH=./data/devlog.db
